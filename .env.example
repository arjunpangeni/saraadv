# Database (Postgres with pgvector). In production use sslmode=require and a private host.
DATABASE_URL="postgresql://asar:asar_dev_password@localhost:5432/asar_partners?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-openssl-rand--base64-32"
AUTH_URL="http://localhost:3000"
# Required behind Railway/load balancers so rate limits and audit logs see real client IPs
AUTH_TRUST_PROXY="false"
# Comma-separated extra Host values allowed for auth redirects (production)
# AUTH_TRUSTED_HOSTS="www.example.com"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary (photos, PDFs, Excel). Leave empty to store files on local disk in ./.storage.
# Console → Settings → API Keys: https://console.cloudinary.com/app/settings/api-keys
# Either set the three values below, or paste the API environment variable as CLOUDINARY_URL.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# AI search / embeddings (optional - falls back to keyword search if unset)
OPENAI_API_KEY=""
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Google Analytics 4 (optional). Leave empty until the site is live.
# Measurement ID (G-XXXXXXXX) loads the browser tracker.
# Rebuild after changing this value so the production CSP script hash stays in sync.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# Property ID (numbers only, from GA4 Admin → Property settings) powers /admin/analytics traffic.
GA4_PROPERTY_ID=""
# Service account JSON (Viewer on the GA4 property). Keep this server-only — never NEXT_PUBLIC_.
# Paste the key file as one line, or use GA4_CLIENT_EMAIL + GA4_PRIVATE_KEY instead.
GA4_SERVICE_ACCOUNT_JSON=""
# GA4_CLIENT_EMAIL=""
# GA4_PRIVATE_KEY=""

# Public site URL (used for SEO metadata, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Extra hosts allowed to load the Next.js dev server (comma-separated, no http://)
# ALLOWED_DEV_ORIGINS="192.168.1.23"

# Google sign-in (optional). Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Admin desk emails (Resend). EMAIL_FROM must be a verified Resend domain.
# ADMIN_NOTIFICATION_EMAIL can be a single address or a comma-separated list.
RESEND_API_KEY=""
EMAIL_FROM="ASAR Partners <noreply@example.com>"
ADMIN_NOTIFICATION_EMAIL=""

# Optional: password for first-time admin seed only (production). Never commit a real value.
# Local seed defaults to Password123! when unset. Existing admin passwords are never overwritten.
# SEED_ADMIN_PASSWORD=""
